# /etc/taskapp/backup-upload.env   (root-owned, mode 0600, never in git)
# How backups leave the machine, and who is told when something is wrong. PLACEHOLDERS only.
#
# The credential used here must be able to ADD files and nothing else: no read, no list, no overwrite, no delete.
# Then a break-in on this machine cannot read or erase the history. Create that credential yourself, in your own
# account, when you decide where backups go; nothing in this kit creates one.

# rclone or gsutil. No other value is accepted (the script has a fixed command for each, never a string it runs).
UPLOAD_TOOL=__REPLACE_WITH_rclone_OR_gsutil__
# rclone: remote:bucket/folder        gsutil: gs://bucket/folder        (no trailing slash)
UPLOAD_TARGET=__REPLACE_WITH_DESTINATION__
# Path of the credential file (the file itself lives outside git, root-owned 0600, readable by the service through systemd).
# rclone: RCLONE_CONFIG        gsutil: GOOGLE_APPLICATION_CREDENTIALS (a service-account key with create-only rights)
RCLONE_CONFIG=/etc/taskapp/rclone.conf
GOOGLE_APPLICATION_CREDENTIALS=/etc/taskapp/upload-key.json

# Optional: a dead-man's-switch address that is called (empty request, no data) after every successful upload.
# If the pings stop, that service alerts you even if this whole machine is gone.
HEALTHCHECK_PING_URL=

# Optional: where alerts go. A chat or paging webhook that accepts {"text": "..."}. The message holds a unit name or
# an age in hours, never data from the app.
ALERT_WEBHOOK_URL=

# How old the newest backup may be before the check complains (seconds). 3 hours.
MAX_AGE_SECONDS=10800
