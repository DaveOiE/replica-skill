# /etc/taskapp/app.env   (root-owned, mode 0600, never in git)
# Settings for the app itself. Every __REPLACE_...__ must be filled in: the app refuses to start while any setting still holds a placeholder.
# There is NO secret in this file: the backup key, the storage credentials and the alert address live in /etc/taskapp/credentials and reach only the backup user's units.

# Where the app listens (127.0.0.1 only; Caddy forwards to it) and where it keeps its database.
PORT=3000
DB_PATH=/var/lib/taskapp/app.db

# The public https address, no trailing slash. The service runs with NODE_ENV=production, so this must be https. It also makes the session cookie Secure
# and turns on HSTS. Leave COOKIE_SECURE unset: it follows this value.
PUBLIC_URL=https://__REPLACE_WITH_YOUR_DOMAIN__

# Caddy runs on this machine in front of the app, so trust it for the caller's address.
TRUST_PROXY=true

# Sessions: longest life, and how long unused before they end.
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120

# The Node version this build was tested on. check-node.sh refuses to start the app on any other. It must equal .nvmrc in the repository.
NODE_VERSION_PIN=22.22.0
