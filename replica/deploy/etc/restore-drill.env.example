# /etc/taskapp/restore-drill.env   (root-owned, mode 0600; used only when you run the restore drill by hand)
# The drill needs to READ backups, so it uses a different credential from the upload one: read and list only.
# Keep this credential off the machine when it is not in use, or create it only for the drill. PLACEHOLDERS only.
DRILL_TOOL=__REPLACE_WITH_rclone_OR_gsutil__
DRILL_SOURCE=__REPLACE_WITH_DESTINATION__
DRILL_RCLONE_CONFIG=/etc/taskapp/rclone-read.conf
DRILL_GOOGLE_APPLICATION_CREDENTIALS=/etc/taskapp/read-key.json
# A scratch folder. It must not be the live database folder; it is emptied afterwards.
DRILL_DIR=/var/tmp/taskapp-drill
# A spare port for the throw-away copy of the app. Not the live port.
DRILL_PORT=3099
