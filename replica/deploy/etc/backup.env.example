# /etc/taskapp/backup.env   (root-owned, mode 0600, never in git)
# Settings for the backup user's units. Nothing secret: the key and the credentials are in /etc/taskapp/credentials and arrive as systemd credentials.
# Every __REPLACE_...__ must be filled in; the scripts refuse to run while one is left.

# Where backups go: a Google Cloud Storage bucket in a SEPARATE project, and a folder in it. No trailing slash. If you change the folder name, change the prefixes in gcs/lifecycle.json too.
GCS_PREFIX=gs://__REPLACE_WITH_BUCKET_NAME__/backups

# The daily copy is the first run at or after this hour (UTC) each day; the monthly copy is the first such run each month.
DAILY_HOUR=2

# How old the newest backup of each kind may be before the check complains, in seconds: hourly 3 hours, daily 26 hours, monthly 32 days.
MAX_AGE_HOURLY=10800
MAX_AGE_DAILY=93600
MAX_AGE_MONTHLY=2764800

# The Node version this build was tested on (same value as in app.env).
NODE_VERSION_PIN=22.22.0

# Folders. SNAPSHOT_DIR is shared with the app user (step 1 writes the plain, checked copy there; step 2 reads it and deletes it).
SNAPSHOT_DIR=/var/lib/taskapp-snapshot
OUTBOX=/var/lib/taskapp-backup/outbox
STATE_DIR=/var/lib/taskapp-backup

# Used only by the restore drill, to be sure it never goes near the live data: the live database's path and port, a base folder it makes scratch folders in,
# and a spare port for the throw-away app.
LIVE_DB_PATH=/var/lib/taskapp/app.db
LIVE_PORT=3000
DRILL_BASE=/var/lib/taskapp-backup/drill
DRILL_PORT=3099
