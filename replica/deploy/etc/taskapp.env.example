# /etc/taskapp/taskapp.env   (root-owned, mode 0600, never in git)
# Every value below is a PLACEHOLDER. Replace each __REPLACE_...__ before starting anything.
# The app refuses to start, or the backup refuses to run, while a placeholder is still in place.

# Where the app listens (127.0.0.1 only; Caddy forwards to it) and where it keeps its database.
PORT=3000
DB_PATH=/var/lib/taskapp/app.db

# The public https address, no trailing slash. https here also makes the session cookie Secure and turns on HSTS.
# Leave COOKIE_SECURE unset: it follows this value.
PUBLIC_URL=https://__REPLACE_WITH_YOUR_DOMAIN__

# Caddy runs on this machine in front of the app, so trust it for the caller's address.
TRUST_PROXY=true

# Sessions: longest life, and how long unused before they end.
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120

# Backups. BACKUP_KEY is 64 hex characters from `npm run backup:keygen`; keep a second copy off this machine.
# BACKUP_DEST is a LOCAL staging folder: backup.sh uploads what lands there, then removes it.
BACKUP_KEY=__REPLACE_WITH_OUTPUT_OF_npm_run_backup_keygen__
BACKUP_DEST=file:/var/lib/taskapp-backup/outbox

# The Node version this build was tested on. check-node.sh refuses to start the app on any other.
# It must equal .nvmrc in the repository.
NODE_VERSION_PIN=22.22.0
