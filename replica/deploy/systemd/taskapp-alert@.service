# Started by OnFailure= in the other units. %i is the name of the unit that failed. Sends one alert; never touches data.
[Unit]
Description=Alert: %i failed

[Service]
Type=oneshot
User=taskapp-backup
Group=taskapp-backup
LoadCredential=alert-webhook:/etc/taskapp/credentials/alert-webhook
ExecStart=/opt/taskapp/current/replica/deploy/bin/alert.sh "unit %i failed on this machine. See: journalctl -u %i"
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
InaccessiblePaths=/var/lib/taskapp /etc/taskapp
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LimitCORE=0
