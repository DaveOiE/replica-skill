# Runs the hourly backup. Persistent=true: if the machine was off at the time, it runs once when it comes back.
# Odd minutes on purpose, so the three kinds never start together.
[Unit]
Description=Backup timer (hourly)

[Timer]
OnCalendar=*-*-* *:07:00
Persistent=true
RandomizedDelaySec=60
Unit=taskapp-backup@hourly.service

[Install]
WantedBy=timers.target
