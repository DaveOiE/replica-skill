# Runs the daily backup. Persistent=true: if the machine was off at the time, it runs once when it comes back.
# Odd minutes on purpose, so the three kinds never start together.
[Unit]
Description=Backup timer (daily)

[Timer]
OnCalendar=*-*-* 00:17:00
Persistent=true
RandomizedDelaySec=60
Unit=taskapp-backup@daily.service

[Install]
WantedBy=timers.target
