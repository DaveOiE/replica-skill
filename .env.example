PORT=3000
DB_PATH=data/app.db
SESSION_HOURS=12
# COOKIE_SECURE: leave unset. It is true automatically when PUBLIC_URL starts with https.
# TRUST_PROXY=true only when a reverse proxy on the same machine forwards requests (it must set X-Forwarded-For).
PUBLIC_URL=http://127.0.0.1:3000
# Backups (names only; real values live in the service's private environment file, never in git):
# BACKUP_KEY=       32 bytes as 64 hex characters. Make one with: npm run backup:keygen
# BACKUP_DEST=      file:/path/to/a/folder on a different disk or machine
